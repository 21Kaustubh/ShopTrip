# ShopTrip — root .gitignore
# Covers secrets, build artefacts, and OS noise for the whole monorepo.

# ── Environment / Secrets ────────────────────────────────────────────────────
# Never commit real .env files. Only .env.example files are allowed in git.
**/.env
**/.env.local
**/.env.development
**/.env.production
**/.env.test
# Allow example templates
!**/.env.example

# ── Node / npm ───────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# ── TypeScript build output ──────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Prisma ───────────────────────────────────────────────────────────────────
# Generated client is rebuilt from schema; do not commit it
backend/node_modules/

# ── Expo / React Native ──────────────────────────────────────────────────────
.expo/
web-build/
expo-env.d.ts

# ── macOS / Windows / Linux OS files ────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Native mobile (generated by Expo prebuild) ───────────────────────────────
/mobile/ios
/mobile/android
