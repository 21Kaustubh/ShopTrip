# ==============================================================================
# ShopTrip Backend Environment Variables (Example Template)
# ==============================================================================
# COPY THIS FILE TO .env AND POPULATE WITH REAL CREDENTIALS.
# NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Connection String
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
# Example local: postgresql://postgres:postgres@localhost:5432/shoptrip_db?schema=public
# Example Supabase / Neon: postgresql://username:secret@ep-xyz.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/shoptrip?schema=public"

# Authentication Security (JWT Secret)
# Generate a strong random key: openssl rand -base64 32
JWT_SECRET="replace-with-a-secure-random-32-byte-hex-or-base64-string"
JWT_EXPIRES_IN="7d"

# Allowed CORS Origins (Comma-separated for multiple origins)
# Web preview: http://localhost:8081, Expo dev server: http://localhost:19006
CORS_ORIGINS="http://localhost:8081,http://localhost:19006,http://localhost:3000"
