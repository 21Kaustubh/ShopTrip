# Public API URL reachable by the mobile app or web preview
# Local Web Preview: http://localhost:3000/api
# Android Emulator:  http://10.0.2.2:3000/api
# iOS Simulator:     http://localhost:3000/api
# Physical Device:   http://<YOUR_LOCAL_NETWORK_IP>:3000/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api
